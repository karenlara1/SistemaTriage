# ============================================================
# Dockerfile para SistemaTriage - Frontend (Angular 21)
# Multi-stage build: compila con Node.js, sirve con Nginx
# ============================================================

# ─────────────────────────────────────────────────────────────
# ETAPA 1: BUILD
# Usamos Node.js 22 (LTS) para compilar Angular
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# OPTIMIZACIÓN DE CACHÉ:
# Primero copiamos solo package.json y package-lock.json
# Si no cambian, Docker reutiliza la capa con node_modules instalados
COPY frontend/package*.json ./

# Instalar dependencias (ci es más estricto y rápido que install en CI/CD)
RUN npm ci

# Copiar el resto del código fuente del frontend
COPY frontend/ .

# Compilar Angular en modo producción
# Los archivos quedan en dist/frontend/browser/
RUN npm run build -- --configuration=production

# ─────────────────────────────────────────────────────────────
# ETAPA 2: RUNTIME
# Nginx sirve los archivos estáticos compilados
# La imagen nginx:alpine pesa ~25MB, ideal para producción
# ─────────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

LABEL maintainer="UniQuindío - Programación Avanzada"
LABEL description="Frontend del Sistema de Triage - Angular 21"

# Eliminar la config por defecto de Nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiar nuestra configuración personalizada de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar los archivos compilados de Angular al directorio de Nginx
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html

# Exponer el puerto 80 (HTTP)
EXPOSE 80

# Nginx se inicia automáticamente con el CMD por defecto de la imagen